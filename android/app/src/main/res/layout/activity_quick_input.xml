<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="새 메모"
        android:textColor="@color/widget_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_memo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_input_bg"
        android:gravity="top|start"
        android:hint="기억해야 할 것을 입력하세요..."
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:maxLines="6"
        android:padding="14dp"
        android:textColor="@color/widget_text"
        android:textColorHint="@color/widget_sub"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="취소"
            android:textColor="@color/widget_sub"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_pin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="알림 고정하기"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
